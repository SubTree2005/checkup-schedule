DATABASE_URL=mysql+pymysql://checkup:change-me@mysql-host:3306/checkup_schedule?charset=utf8mb4
COOKIE_SECURE=true
ALLOWED_ORIGINS=
CHATANYWHERE_API_KEY=replace-with-deployment-secret
CHATANYWHERE_API_URL=https://api.chatanywhere.tech/v1/chat/completions
CHATANYWHERE_MODEL=deepseek-v4-flash
CHATANYWHERE_TIMEOUT_SECONDS=45
CHATANYWHERE_MAX_RESPONSE_BYTES=1048576
MAX_REQUEST_BODY_BYTES=8388608
# These counters are per process; use the trusted ingress or a shared store for cluster-wide quotas.
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_ATTEMPTS=10
AI_RATE_LIMIT_REQUESTS=20
SCHEDULER_RATE_LIMIT_REQUESTS=20
# Only enable when the deployment ingress overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

