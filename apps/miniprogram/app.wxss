page {
  background:
    radial-gradient(circle at 50% 4%, rgba(207, 226, 255, 0.64), rgba(247, 249, 253, 0) 34%),
    linear-gradient(180deg, #F6F9FE 0%, #FFFFFF 100%);
  color: #172033;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

view, text, button, navigator, input, textarea, image {
  box-sizing: border-box;
}

view, text, button, navigator {
  overflow-wrap: break-word;
}

.container {
  padding: 28rpx 28rpx 48rpx;
}

.card {
  background: linear-gradient(145deg, #FFFFFF, #F2F7FF);
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 42rpx rgba(49, 76, 125, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.96);
}

.liquid-icon {
  display: block;
  flex: none;
  object-fit: contain;
}

.page-head {
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #172033;
}

.page-desc {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #7B8794;
  line-height: 1.7;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #1F2937;
}

.section-subtitle {
  font-size: 26rpx;
  color: #6B7280;
}

.primary-btn {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #5B8EFF 0%, #2F69EC 100%);
  color: #FFFFFF;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid rgba(255, 255, 255, 0.42);
  min-height: 96rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  box-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.5), 0 14rpx 30rpx rgba(45, 104, 236, 0.24);
}

.primary-btn::after,
.secondary-btn::after,
.outline-btn::after {
  border: none;
}

.secondary-btn {
  background: rgba(255, 255, 255, 0.68);
  color: #2F69EC;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: 2rpx solid rgba(197, 214, 248, 0.72);
  min-height: 84rpx;
  display:flex;
  align-items:center;
  justify-content:center;
}

.outline-btn {
  background: rgba(255, 255, 255, 0.62);
  color: #2F69EC;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 700;
  border: 2rpx solid #CFE0FF;
  min-height: 84rpx;
  display:flex;
  align-items:center;
  justify-content:center;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #EAF2FF;
  color: #4F83F1;
  font-size: 22rpx;
}

.input {
  width: 100%;
  background: rgba(255, 255, 255, 0.74);
  border-radius: 24rpx;
  padding: 24rpx 22rpx;
  font-size: 26rpx;
  color: #1F2937;
  border: 2rpx solid transparent;
}

.label {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2A44;
  margin-bottom: 14rpx;
}

.form-item + .form-item {
  margin-top: 24rpx;
}

.option-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.option {
  min-width: 180rpx;
  text-align: center;
  background: #F8FBFF;
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  color: #516072;
  border: 2rpx solid transparent;
  font-size: 26rpx;
}

.option-active {
  background: #EAF2FF;
  color: #1350BE;
  border-color: #BFD4FF;
}

.muted {
  color: #6B7280;
}

.row {
  display: flex;
  align-items: center;
}

.space-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mt-40 { margin-top: 40rpx; }

.status-pending { color: #9CA3AF; }
.status-active { color: #4F83F1; }
.status-done { color: #16A34A; }

.safe-top {
  padding-top: calc(env(safe-area-inset-top) + 20rpx);
}

.tab-page {
  min-height: 100vh;
  padding-bottom: calc(env(safe-area-inset-bottom) + 184rpx);
}
