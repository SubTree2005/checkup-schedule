<view wx:if="{{!hidden}}" class="tab-safe-area">
  <view class="liquid-tabbar">
    <view
      class="tab-item {{selected === index ? 'tab-active' : ''}}"
      wx:for="{{list}}"
      wx:key="pagePath"
      data-index="{{index}}"
      bindtap="switchTab"
      aria-label="{{item.text}}"
    >
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
