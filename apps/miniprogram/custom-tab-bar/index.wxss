.tab-safe-area {
  position: fixed;
  z-index: 999;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 10rpx 24rpx calc(env(safe-area-inset-bottom) + 34rpx);
  pointer-events: none;
}

.liquid-tabbar {
  position: relative;
  height: 86rpx;
  padding: 8rpx;
  display: flex;
  align-items: stretch;
  background: #F4F8FF;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 38rpx;
  box-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.82), 0 18rpx 48rpx rgba(40, 64, 108, 0.18);
  pointer-events: auto;
}

.tab-indicator {
  position: absolute;
  z-index: 0;
  top: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  width: calc((100% - 16rpx) / 3);
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 30rpx;
  box-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.96), 0 8rpx 22rpx rgba(46, 94, 190, 0.14);
  transform: translate3d(0, 0, 0);
  pointer-events: none;
}

.tab-indicator-1 { transform: translate3d(100%, 0, 0); }
.tab-indicator-2 { transform: translate3d(200%, 0, 0); }

.tab-item {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8490A3;
  border-radius: 30rpx;
}

.tab-active {
  color: #245FDE;
}

.tab-text {
  font-size: 24rpx;
  font-weight: 600;
}
