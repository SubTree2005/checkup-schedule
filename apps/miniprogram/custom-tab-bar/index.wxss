.tab-safe-area {
  position: fixed;
  z-index: 999;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 10rpx 24rpx calc(env(safe-area-inset-bottom) + 14rpx);
  pointer-events: none;
}

.liquid-tabbar {
  height: 86rpx;
  padding: 8rpx;
  display: flex;
  align-items: stretch;
  background: rgba(244, 248, 255, 0.78);
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 38rpx;
  box-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.82), 0 18rpx 48rpx rgba(40, 64, 108, 0.18);
  backdrop-filter: blur(28rpx) saturate(180%);
  -webkit-backdrop-filter: blur(28rpx) saturate(180%);
  pointer-events: auto;
}

.tab-item {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8490A3;
  border-radius: 30rpx;
}

.tab-active {
  color: #245FDE;
  background: rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  box-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.96), 0 8rpx 22rpx rgba(46, 94, 190, 0.14);
}

.tab-text {
  font-size: 24rpx;
  font-weight: 600;
}
