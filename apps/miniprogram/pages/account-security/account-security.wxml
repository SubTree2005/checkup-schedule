<view class="account-page safe-top">
  <view class="flow-nav">
    <view class="nav-back" bindtap="goBack" aria-label="返回">‹</view>
    <view class="nav-title">账号与隐私</view>
    <view class="nav-space"></view>
  </view>

  <scroll-view class="account-scroll" scroll-y="true">
    <view class="section-label">隐私与协议</view>
    <view class="menu-card">
      <view class="menu-row" bindtap="openTerms">
        <view class="menu-title">用户协议</view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-row" bindtap="openPrivacy">
        <view class="menu-title">隐私政策</view>
        <view class="menu-arrow">›</view>
      </view>
    </view>

    <view class="section-label action-label">账号操作</view>
    <view class="menu-card">
      <view class="menu-row logout-row" bindtap="logout">
        <view class="logout-title">退出登录</view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-row" bindtap="openDeleteAccount">
        <view class="delete-entry-title">注销账号</view>
        <view class="menu-arrow">›</view>
      </view>
    </view>
  </scroll-view>
</view>
<ai-agent />
