<view class="container">
  <view class="card">
    <view class="section-title">协议与隐私</view>
    <view class="menu-item" bindtap="openTerms"><view>用户协议</view><view class="menu-arrow">></view></view>
    <view class="menu-item" bindtap="openPrivacy"><view>隐私政策</view><view class="menu-arrow">></view></view>
  </view>

  <view class="card mt-24 danger-card">
    <view class="section-title danger-title">注销账号</view>
    <view class="danger-copy">注销后将删除当前账号、登录会话、健康状态、体检计划和执行记录。此操作不可撤回。</view>
    <view class="field-card mt-24">
      <view class="label">当前密码</view>
      <input class="input" password="true" value="{{password}}" bindinput="onPasswordInput" placeholder="输入密码以确认本人操作" />
    </view>
    <button class="danger-button mt-24" loading="{{deleting}}" disabled="{{deleting}}" bindtap="deleteAccount">永久注销账号</button>
  </view>
</view>
