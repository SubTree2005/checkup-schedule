@import '../../app.wxss';

page { background: linear-gradient(180deg, #F6F9FE 0%, #FFFFFF 100%); }
.account-page { min-height: 100vh; }
.flow-nav { height: 128rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: space-between; }
.nav-back { width: 64rpx; height: 64rpx; display: flex; align-items: center; color: #101827; font-size: 58rpx; }
.nav-title { color: #111827; font-size: 31rpx; font-weight: 650; }
.nav-space { width: 64rpx; }
.account-scroll { width: 100%; height: calc(100vh - env(safe-area-inset-top) - 148rpx); padding: 8rpx 28rpx 56rpx; box-sizing: border-box; }
.section-label { margin: 0 8rpx 16rpx; color: #5B6779; font-size: 24rpx; font-weight: 600; }
.action-label { margin-top: 32rpx; }
.menu-card { background: rgba(255,255,255,0.94); border: 2rpx solid #E0E7F1; border-radius: 26rpx; box-shadow: 0 14rpx 36rpx rgba(50,75,118,0.06); }
.menu-card { padding: 0 26rpx; }
.menu-row { min-height: 100rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 2rpx solid #EDF1F6; }
.menu-row:last-child { border-bottom: none; }
.menu-title { color: #172033; font-size: 25rpx; font-weight: 600; }
.logout-title,
.delete-entry-title { color: #FF3B30; font-size: 25rpx; font-weight: 600; }
.menu-arrow { color: #9AA5B5; font-size: 38rpx; }
