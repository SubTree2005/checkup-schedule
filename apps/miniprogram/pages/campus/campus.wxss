@import '../../app.wxss';
.page-head { margin-bottom: 24rpx; }
.page-title { font-size: 42rpx; font-weight: 800; color:#1F2A44; }
.page-desc { margin-top: 10rpx; font-size: 25rpx; color:#7B8794; line-height: 1.7; }
.campus-card { padding: 28rpx; margin-bottom: 24rpx; }
.campus-card-disabled { opacity: 0.88; }
.campus-top { display:flex; align-items:center; justify-content:space-between; }
.campus-name { font-size: 32rpx; font-weight: 700; color:#1F2A44; }
.campus-badge { padding: 8rpx 18rpx; border-radius: 999rpx; font-size: 22rpx; }
.campus-badge-open { background:#EAF2FF; color:#1350BE; }
.campus-badge-wait { background:#F3F4F6; color:#7B8794; }
.campus-info { margin-top: 16rpx; font-size: 25rpx; color:#5B6475; }
.pick-btn { margin-top: 24rpx; }
