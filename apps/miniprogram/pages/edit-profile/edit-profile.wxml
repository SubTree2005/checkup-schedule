<view class="profile-page safe-top">
  <view class="flow-nav">
    <view class="nav-back" bindtap="goBack" aria-label="返回">‹</view>
    <view class="nav-title">个人资料</view>
    <view class="nav-space"></view>
  </view>

  <scroll-view class="profile-scroll" scroll-y="true">
    <view class="section-label">基础信息</view>
    <view class="form-card">
      <view class="avatar-row" bindtap="chooseAvatar" role="button" aria-label="更换头像">
        <view class="row-label">头像</view>
        <view class="avatar-action">
          <image class="profile-avatar" src="{{avatarPreview}}" mode="aspectFill"></image>
          <view class="avatar-copy">更换</view>
          <view class="avatar-arrow">›</view>
        </view>
      </view>
      <view class="form-row">
        <view class="row-label">姓名</view>
        <input class="row-input" value="{{form.name}}" data-key="name" bindinput="onInput" placeholder="请输入姓名" placeholder-class="input-placeholder" />
      </view>
      <view class="form-row">
        <view class="row-label">性别</view>
        <view class="segmented-control">
          <view class="segment {{form.gender==='女' ? 'segment-active' : ''}}" data-key="gender" data-value="女" bindtap="setField">女</view>
          <view class="segment {{form.gender==='男' ? 'segment-active' : ''}}" data-key="gender" data-value="男" bindtap="setField">男</view>
        </view>
      </view>
      <view class="form-row">
        <view class="row-label">年龄</view>
        <input class="row-input" type="number" value="{{form.age}}" data-key="age" bindinput="onInput" placeholder="请输入年龄" placeholder-class="input-placeholder" />
      </view>
      <view class="form-row">
        <view class="row-label">手机号</view>
        <input class="row-input" type="number" maxlength="11" value="{{form.phone}}" data-key="phone" bindinput="onInput" placeholder="请输入手机号" placeholder-class="input-placeholder" />
      </view>
    </view>

    <view class="section-label second-section">健康信息</view>
    <view class="form-card">
      <view class="text-field">
        <view class="row-label">既往病史</view>
        <input class="text-input" value="{{profile.medicalHistory}}" data-key="medicalHistory" bindinput="onProfileInput" placeholder="无则填写 -" placeholder-class="input-placeholder" />
      </view>
      <view class="text-field last-field">
        <view class="row-label">过敏原</view>
        <input class="text-input" value="{{profile.allergens}}" data-key="allergens" bindinput="onProfileInput" placeholder="无则填写 -" placeholder-class="input-placeholder" />
      </view>
    </view>

    <button class="save-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="saveAll">保存</button>
  </scroll-view>
</view>
<ai-agent />
