<view class="container">
  <view class="page-head">
    <view class="page-title">编辑个人信息</view>
    <view class="page-desc">你可以在这里维护基础信息与身体状态，后续体检规划会参考这些内容。</view>
  </view>

  <view class="card profile-form-card">
    <view class="section-title">基础资料</view>
    <view class="field-card">
      <view class="label">姓名</view>
      <input class="input" value="{{form.name}}" data-key="name" bindinput="onInput" placeholder="请输入姓名" />
    </view>
    <view class="field-card mt-24">
      <view class="label">性别</view>
      <view class="option-row">
        <view class="option {{form.gender==='女' ? 'option-active' : ''}}" data-key="gender" data-value="女" bindtap="setField">女</view>
        <view class="option {{form.gender==='男' ? 'option-active' : ''}}" data-key="gender" data-value="男" bindtap="setField">男</view>
      </view>
    </view>
    <view class="field-card mt-24">
      <view class="label">年龄</view>
      <input class="input" type="number" value="{{form.age}}" data-key="age" bindinput="onInput" placeholder="请输入年龄" />
    </view>
    <view class="field-card mt-24">
      <view class="label">手机号</view>
      <input class="input" type="number" value="{{form.phone}}" data-key="phone" bindinput="onInput" placeholder="请输入手机号" />
    </view>
  </view>

  <view class="card mt-24 profile-form-card">
    <view class="section-title">身体状态</view>
    <view class="field-card">
      <view class="label">是否空腹</view>
      <view class="option-row">
        <view class="option {{profile.fasting==='yes' ? 'option-active' : ''}}" data-key="fasting" data-value="yes" bindtap="setProfileField">是</view>
        <view class="option {{profile.fasting==='no' ? 'option-active' : ''}}" data-key="fasting" data-value="no" bindtap="setProfileField">否</view>
      </view>
    </view>
    <view class="field-card mt-24">
      <view class="label">膀胱充盈状态</view>
      <view class="option-row">
        <view class="option {{profile.bladder==='normal' ? 'option-active' : ''}}" data-key="bladder" data-value="normal" bindtap="setProfileField">正常</view>
        <view class="option {{profile.bladder==='recentUrination' ? 'option-active' : ''}}" data-key="bladder" data-value="recentUrination" bindtap="setProfileField">半小时内排尿</view>
      </view>
    </view>
    <view class="field-card mt-24">
      <view class="label">喝水情况</view>
      <view class="option-row">
        <view class="option {{profile.drinkingWater==='adequate' ? 'option-active' : ''}}" data-key="drinkingWater" data-value="adequate" bindtap="setProfileField">已喝水</view>
        <view class="option {{profile.drinkingWater==='notyet' ? 'option-active' : ''}}" data-key="drinkingWater" data-value="notyet" bindtap="setProfileField">未喝水</view>
      </view>
    </view>
    <view class="field-card mt-24">
      <view class="label">既往病史</view>
      <input class="input" value="{{profile.medicalHistory}}" data-key="medicalHistory" bindinput="onProfileInput" placeholder="默认 -，可自由填写" />
    </view>
    <view class="field-card mt-24">
      <view class="label">过敏原</view>
      <input class="input" value="{{profile.allergens}}" data-key="allergens" bindinput="onProfileInput" placeholder="默认 -，可自由填写" />
    </view>
  </view>

  <button class="primary-btn mt-24" bindtap="saveAll">保存修改</button>
</view>
