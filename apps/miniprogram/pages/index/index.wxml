<view class="home-page tab-page safe-top" style="padding-top: {{statusBarHeight}}px;">
  <view class="home-topbar" style="height: {{navigationBarHeight}}px;"><image class="home-logo" src="../../addpicture/logo.png" mode="widthFix"></image></view>

  <view wx:if="{{!hasHomeContent}}" class="empty-home">
    <view class="plan-orb-wrap"><view class="plan-orb-halo"></view><view class="plan-orb" bindtap="goStart" role="button" aria-label="开始体检"><view class="plan-orb-label">开始体检</view></view></view>
  </view>

  <view wx:else class="plan-home">
    <view class="plan-heading"><view class="plan-heading-title">{{homeTitle}}</view><view class="plan-heading-subtitle">{{homeSubtitle}}</view></view>

    <view wx:if="{{currentPlan}}" class="plan-surface plan-{{planState}} home-highlight">
      <view class="hospital-name">{{currentPlan.hospitalName}}</view>
      <view class="package-name">{{currentPlan.packageName}}</view>
      <view class="progress-row"><view><text class="progress-strong">{{completedSteps}}</text><text class="progress-total"> / {{totalSteps}} 项已完成</text></view><view class="progress-percent">{{progress}}%</view></view>
      <view class="progress-track" aria-label="体检进度 {{progress}}%"><view class="progress-fill" style="width: {{progress}}%;"></view></view>
      <scroll-view class="timeline-scroll" scroll-x="true" enable-flex="true" scroll-left="{{timelineScrollLeft}}" show-scrollbar="false">
        <view class="timeline"><view class="timeline-line"></view><view class="timeline-step step-{{item.state}}" wx:for="{{timelineSteps}}" wx:key="detailID"><view class="step-dot"><image wx:if="{{item.state === 'done'}}" class="step-check" src="../../addpicture/icons/icon-check.png" mode="aspectFit"></image></view><view class="step-name">{{item.title}}</view><view class="step-time">{{item.time}}</view></view></view>
      </scroll-view>
      <view wx:if="{{currentMessage}}" class="current-message">{{currentMessage}}</view>
      <button class="primary-btn plan-primary" style="width: 100%; margin-left: 0; margin-right: 0;" bindtap="handlePrimary">{{primaryActionText}}</button>
      <view class="overview-link" bindtap="goOverview" role="button">查看体检总览</view>
    </view>

    <view class="feed-card feed-{{item.type}} {{item.highlighted ? 'feed-highlight' : ''}}" wx:for="{{feedCards}}" wx:key="id" data-id="{{item.id}}" bindtap="openFeedCard">
      <view class="feed-top"><view class="feed-eyebrow">{{item.eyebrow}}</view><view class="feed-status status-{{item.type}}">{{item.statusText}}</view></view>
      <view class="feed-hospital">{{item.hospitalName}}</view>
      <view class="feed-package">{{item.packageName}}</view>
      <view class="feed-bottom"><view class="feed-meta"><view>{{item.timeLabel}}</view><view wx:if="{{item.reportText}}" class="feed-report-count">{{item.reportText}}</view></view><view class="feed-action">{{item.actionText}}</view></view>
    </view>
  </view>
</view>
<ai-agent id="aiAgent" with-tab-bar />
