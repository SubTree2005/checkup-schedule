@import '../../app.wxss';

page {
  background:
    radial-gradient(circle at 50% 12%, rgba(201, 222, 255, 0.72), rgba(247, 249, 253, 0) 36%),
    linear-gradient(180deg, #F5F9FF 0%, #F8FAFD 54%, #FFFFFF 100%);
}

.home-page {
  width: 100%;
  padding-left: 28rpx;
  padding-right: 28rpx;
  overflow-x: hidden;
}

.home-topbar {
  height: 96rpx;
  display: flex;
  align-items: center;
  padding-left: 8rpx;
}

.home-logo { width: 188rpx; mix-blend-mode: multiply; }

.empty-home {
  min-height: calc(100vh - env(safe-area-inset-top) - 330rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-orb-wrap {
  position: relative;
  width: 410rpx;
  height: 410rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-orb-halo {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 50%;
  background: rgba(91, 142, 255, 0.11);
  box-shadow: 0 28rpx 70rpx rgba(47, 105, 236, 0.18);
}

.plan-orb {
  position: relative;
  z-index: 1;
  width: 332rpx;
  height: 332rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  background: linear-gradient(180deg, #5B8EFF 0%, #2F69EC 100%);
  border: 3rpx solid rgba(255, 255, 255, 0.58);
  box-shadow: inset 0 3rpx 3rpx rgba(255, 255, 255, 0.48), 0 22rpx 48rpx rgba(47, 105, 236, 0.28);
}

.plan-orb-label { font-size: 36rpx; font-weight: 600; }

.plan-home { padding-top: 28rpx; }

.plan-heading { padding: 0 8rpx 28rpx; }

.plan-heading-title {
  color: #172033;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.plan-heading-subtitle {
  margin-top: 12rpx;
  color: #67748B;
  font-size: 26rpx;
}

.plan-surface {
  padding: 34rpx 30rpx 30rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 34rpx;
  box-shadow: 0 18rpx 52rpx rgba(55, 81, 129, 0.1);
}
.home-highlight, .feed-highlight { border-color: rgba(47, 105, 236, 0.64); box-shadow: 0 18rpx 52rpx rgba(47, 105, 236, 0.14); }

.hospital-name {
  color: #172033;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.45;
}

.package-name {
  margin-top: 8rpx;
  color: #738096;
  font-size: 24rpx;
}

.progress-row {
  margin-top: 38rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  color: #68758B;
  font-size: 24rpx;
}

.progress-strong {
  color: #172033;
  font-size: 31rpx;
  font-weight: 600;
}

.progress-percent {
  color: #536178;
  font-size: 24rpx;
}

.progress-track {
  height: 12rpx;
  margin-top: 16rpx;
  overflow: hidden;
  background: #E8EDF5;
  border-radius: 999rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 240ms ease;
}

.plan-active .progress-fill { background: #2F69EC; }
.plan-scheduled .progress-fill { background: #B27A13; }
.plan-paused .progress-fill { background: #D64C58; }
.plan-complete .progress-fill { background: #189568; }

.timeline-scroll {
  width: 100%;
  margin-top: 26rpx;
  padding-bottom: 8rpx;
  white-space: nowrap;
}

.timeline {
  position: relative;
  min-width: 100%;
  display: inline-flex;
  padding: 0 12rpx;
}

.timeline-line {
  position: absolute;
  top: 16rpx;
  left: 86rpx;
  right: 86rpx;
  height: 8rpx;
  background: #DCE3EE;
}

.timeline-step {
  position: relative;
  z-index: 1;
  width: 190rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.step-dot {
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 3rpx solid #C9D2E1;
  border-radius: 50%;
  overflow: hidden;
}

.step-check { width: 32rpx; height: 32rpx; }

.step-done .step-dot,
.step-active .step-dot { border-color: #2F69EC; }
.step-done .step-dot { background: #2F69EC; }
.plan-paused .step-done .step-dot,
.plan-paused .step-active .step-dot { border-color: #D64C58; }
.plan-paused .step-done .step-dot { background: #D64C58; }
.plan-scheduled .step-done .step-dot,
.plan-scheduled .step-active .step-dot { border-color: #B27A13; }
.plan-scheduled .step-done .step-dot { background: #B27A13; }
.plan-complete .step-done .step-dot { background: #189568; border-color: #189568; }

.step-name {
  width: 174rpx;
  min-height: 34rpx;
  margin-top: 12rpx;
  overflow: hidden;
  color: #4A566B;
  font-size: 21rpx;
  line-height: 34rpx;
  white-space: nowrap;
}

.step-name-track { min-width: 100%; display: inline-flex; justify-content: center; white-space: nowrap; }
.step-name-track.is-scrolling { justify-content: flex-start; animation: step-name-marquee 7s linear infinite; }
.step-name-copy { margin-left: 46rpx; }

.step-active .step-name { color: #172033; font-weight: 600; }

.step-time {
  margin-top: 7rpx;
  color: #8A96A9;
  font-size: 21rpx;
}

.current-message {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  color: #111827;
  font-size: 25rpx;
  line-height: 1.55;
  background: rgba(239, 244, 253, 0.78);
  border-radius: 22rpx;
}

.plan-primary { width: 100%; margin-top: 24rpx; }
.overview-link { padding: 18rpx 0 2rpx; color: #7A879A; font-size: 22rpx; text-align: center; }
.feed-card { margin-top: 22rpx; padding: 26rpx 28rpx; background: rgba(255,255,255,0.9); border: 2rpx solid #DFE7F2; border-radius: 28rpx; box-shadow: 0 14rpx 38rpx rgba(50,75,118,0.07); }
.feed-top, .feed-bottom { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.feed-eyebrow { color: #637087; font-size: 22rpx; font-weight: 600; }
.feed-status { padding: 7rpx 12rpx; border-radius: 10rpx; font-size: 20rpx; font-weight: 600; }
.status-scheduled { color: #2F69EC; background: #EDF4FF; }
.status-report { color: #23884B; background: #EAF8EF; }
.feed-hospital { margin-top: 22rpx; color: #172033; font-size: 28rpx; font-weight: 650; line-height: 1.4; }
.feed-package { margin-top: 7rpx; color: #68758B; font-size: 23rpx; }
.feed-bottom { margin-top: 24rpx; }
.feed-meta { color: #526078; font-size: 23rpx; line-height: 1.5; }
.feed-report-count { margin-top: 4rpx; color: #23884B; font-size: 21rpx; }
.feed-action { flex: none; min-width: 142rpx; min-height: 62rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: center; color: #2F69EC; border: 2rpx solid #BFD4FF; border-radius: 999rpx; font-size: 23rpx; font-weight: 600; }
.feed-card.feed-highlight { border-color: #79A6FF; box-shadow: 0 18rpx 52rpx rgba(47, 105, 236, 0.15); }

@keyframes step-name-marquee {
  0%, 18% { transform: translateX(0); }
  82%, 100% { transform: translateX(calc(-50% - 23rpx)); }
}
