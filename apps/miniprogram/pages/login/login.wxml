<view class="auth-page safe-top">
  <view class="auth-content">
    <view class="brand-block">
      <image class="login-logo-image" src="../../addpicture/logo.png" mode="widthFix"></image>
      <view class="brand-slogan">让体检更高效、更安心</view>
    </view>

    <view class="login-form">
      <view class="glass-field">
        <image class="field-icon" src="../../addpicture/icons/iconfont/login-phone.svg" mode="aspectFit"></image>
        <input class="auth-input" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="auth-placeholder" data-key="account" bindinput="onInput" value="{{form.account}}" />
      </view>

      <view class="glass-field">
        <image class="field-icon" src="../../addpicture/icons/iconfont/login-password.svg" mode="aspectFit"></image>
        <input class="auth-input" password="{{!showPassword}}" maxlength="64" placeholder="请输入密码" placeholder-class="auth-placeholder" data-key="password" bindinput="onInput" value="{{form.password}}" />
        <view class="password-toggle" bindtap="togglePassword" role="button" aria-label="{{showPassword ? '隐藏密码' : '显示密码'}}">
          <image class="password-toggle-icon" src="{{showPassword ? '../../addpicture/icons/iconfont/login-hidden.svg' : '../../addpicture/icons/iconfont/login-visible.svg'}}" mode="aspectFit"></image>
        </view>
      </view>

      <view class="policy-row" bindtap="toggleAgreement">
        <view class="policy-check {{agreed ? 'policy-check-active' : ''}}">{{agreed ? '✓' : ''}}</view>
        <view class="policy-copy">
          我已阅读并同意
          <text class="policy-link" catchtap="openTerms">《用户服务协议》</text>
          <text class="policy-link" catchtap="openPrivacy">《隐私政策》</text>
        </view>
      </view>

      <button class="primary-btn login-btn" style="width: 100%; margin-left: 0; margin-right: 0;" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitLogin">登录</button>

      <view class="register-link">
        <text>还没有账号？</text>
        <text class="register-action" bindtap="goRegister">去注册</text>
      </view>
    </view>
  </view>
</view>
