@import '../../app.wxss';

page {
  background:
    radial-gradient(circle at 50% 28%, rgba(210, 225, 255, 0.52), rgba(247, 249, 253, 0) 38%),
    linear-gradient(180deg, #FBFCFF 0%, #F7F9FD 100%);
}

.auth-page {
  min-height: 100vh;
  overflow: hidden;
}

.auth-content {
  min-height: calc(100vh - env(safe-area-inset-top));
  padding: 90rpx 62rpx calc(env(safe-area-inset-bottom) + 52rpx);
  display: flex;
  flex-direction: column;
}

.brand-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 66rpx;
}

.login-logo-image { width: 344rpx; mix-blend-mode: multiply; }

.brand-slogan {
  margin-top: 30rpx;
  color: #71809B;
  font-size: 28rpx;
  letter-spacing: 8rpx;
}

.login-form { margin-top: 98rpx; }

.glass-field {
  height: 112rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.66);
  border: 2rpx solid rgba(205, 217, 241, 0.78);
  border-radius: 34rpx;
  box-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.92), 0 12rpx 30rpx rgba(67, 92, 142, 0.05);
}

.glass-field + .glass-field { margin-top: 24rpx; }

.field-icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 24rpx;
  flex: none;
  display: block;
  opacity: .94;
}

.auth-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  color: #172033;
  font-size: 30rpx;
}

.auth-placeholder { color: #8996AC; }

.password-toggle {
  width: 64rpx;
  height: 64rpx;
  margin-left: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.password-toggle-icon { width: 42rpx; height: 42rpx; display: block; }

.policy-row {
  margin-top: 30rpx;
  display: flex;
  align-items: flex-start;
}

.policy-check {
  width: 36rpx;
  height: 36rpx;
  margin-top: 1rpx;
  margin-right: 16rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #C4CEE0;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 24rpx;
}

.policy-check-active { border-color: #2F69EC; background: #2F69EC; }

.policy-copy {
  color: #7B879C;
  font-size: 24rpx;
  line-height: 1.6;
}

.policy-link,
.register-action { color: #245FDE; }

.login-btn { margin-top: 58rpx; }
.login-btn[disabled] { opacity: 0.68; }

.register-link {
  margin-top: 64rpx;
  text-align: center;
  color: #7B879C;
  font-size: 26rpx;
}

.register-action { margin-left: 12rpx; font-weight: 600; }
