@import '../../app.wxss';
.auth-page { padding-bottom: 40rpx; }
.auth-hero { text-align:center; }
.login-logo-image { width: 320rpx; max-height: 120rpx; }
.role-row { display:flex; gap: 16rpx; margin-top: 16rpx; }
.role-item { flex:1; background:#F8FBFF; border-radius: 18rpx; padding: 24rpx 20rpx; text-align:center; color:#516072; font-size: 28rpx; font-weight:700; border:2rpx solid transparent; }
.role-active { background:#EAF2FF; color:#1350BE; border-color:#BFD4FF; }
.field-card { background:#F8FBFF; border-radius: 22rpx; padding: 22rpx; border:2rpx solid #E8F0FF; }
.field-card .input { display:block; width:100%; min-width:0; height: 84rpx; line-height: 84rpx; padding: 0; background: transparent; border:none; font-size: 26rpx; white-space: nowrap; overflow: visible; text-overflow: clip; }
.ghost-btn { background:#FFFFFF; border:2rpx solid #DCE8FF; }
