<view class="mine-page tab-page safe-top" style="padding-top: {{statusBarHeight}}px;">
  <view class="mine-nav" style="height: {{navigationBarHeight}}px;">我的</view>

  <view class="user-head">
    <image class="avatar-orb" src="{{avatarUrl}}" mode="aspectFill"></image>
    <view class="user-copy">
      <view class="user-name">{{displayName}}</view>
      <view class="user-phone" wx:if="{{maskedPhone}}">{{maskedPhone}}</view>
    </view>
  </view>

  <view class="menu-card settings-card">
    <view class="menu-row" bindtap="openProfile"><view class="menu-title">个人资料</view><view class="menu-arrow">›</view></view>
    <view class="menu-row" bindtap="openAccount"><view class="menu-title">账号与隐私</view><view class="menu-arrow">›</view></view>
  </view>
  <view class="menu-card settings-card ai-settings-card">
    <view class="menu-row" bindtap="openAiSettings"><view class="menu-title">AI 助手设置</view><view class="menu-arrow">›</view></view>
  </view>
</view>
<ai-agent with-tab-bar />
