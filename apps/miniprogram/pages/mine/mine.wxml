<view class="container">
  <view class="card profile-card">
    <image class="avatar" src="{{user.avatar}}" mode="aspectFill"></image>
    <view class="user-name">{{displayName}}</view>
    <view class="user-sub">{{user.role === 'manager' ? '管理员账户' : '我的体检'}}</view>
  </view>

  <view class="card mt-24 info-card">
    <view class="section-title">个人信息</view>
    <view wx:if="{{hasUserInfo}}">
      <view class="info-line"><text class="info-label">姓名</text><text>{{user.userInfo.name}}</text></view>
      <view class="info-line"><text class="info-label">性别</text><text>{{user.userInfo.gender}}</text></view>
      <view class="info-line"><text class="info-label">年龄</text><text>{{user.userInfo.age}}</text></view>
      <view class="info-line"><text class="info-label">手机号</text><text>{{user.userInfo.phone}}</text></view>
    </view>
    <view wx:else class="empty-hint">暂未注册个人信息，完成注册后会自动展示在这里。</view>
  </view>

  <view class="card mt-24 info-card">
    <view class="section-title">最近身体状态</view>
    <view class="info-line"><text class="info-label">是否空腹</text><text>{{user.profile.fasting === 'yes' ? '是' : '否'}}</text></view>
    <view class="info-line"><text class="info-label">膀胱充盈</text><text>{{user.profile.bladder === 'recentUrination' ? '半小时内排尿' : '正常'}}</text></view>
    <view class="info-line"><text class="info-label">喝水情况</text><text>{{user.profile.drinkingWater === 'notyet' ? '未喝水' : '已喝水'}}</text></view>
    <view class="info-line"><text class="info-label">既往病史</text><text>{{user.profile.medicalHistory || '-'}}</text></view>
    <view class="info-line"><text class="info-label">过敏原</text><text>{{user.profile.allergens || '-'}}</text></view>
  </view>

  <view class="card mt-24">
    <block wx:for="{{menus}}" wx:key="index">
      <view class="menu-item" data-key="{{item.key}}" bindtap="onMenuTap">
        <view>{{item.label}}</view>
        <view class="menu-arrow">></view>
      </view>
    </block>
  </view>
</view>
