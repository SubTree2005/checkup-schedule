@import '../../app.wxss';
.profile-card { display:flex; flex-direction:column; align-items:center; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background:#EAF2FF; }
.user-name { margin-top: 18rpx; font-size: 34rpx; font-weight: 700; }
.user-sub { margin-top: 8rpx; color:#6B7280; font-size: 24rpx; }
.info-card .info-line { display:flex; justify-content:space-between; padding: 16rpx 0; border-bottom: 1rpx solid #EEF2F7; font-size: 26rpx; }
.info-card .info-line:last-child { border-bottom: none; }
.info-label { color:#6B7280; }
.empty-hint { margin-top: 10rpx; background:#F8FBFF; color:#6B7280; font-size: 24rpx; line-height: 1.7; padding: 18rpx; border-radius: 16rpx; }
.menu-item { display:flex; justify-content:space-between; align-items:center; padding: 24rpx 0; border-bottom: 1rpx solid #EEF2F7; }
.menu-item:last-child { border-bottom:none; }
.menu-arrow { color:#9CA3AF; }
