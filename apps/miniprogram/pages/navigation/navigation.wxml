<view class="navigation-page safe-top" style="{{navigationStyle}}">
  <view class="flow-nav">
    <view class="nav-back" bindtap="goBack" aria-label="返回">‹</view>
    <view class="nav-title">体检导航</view>
    <view class="nav-space"></view>
  </view>

  <scroll-view class="navigation-scroll" scroll-y="true">
    <view class="route-notice" wx:if="{{replanNotice}}">{{replanNotice}}</view>
    <view class="destination-card">
      <image class="destination-pin" src="../../addpicture/icons/iconfont/location.svg" mode="aspectFit"></image>
      <view class="destination-copy">当前目的地：<text>{{toName}}</text></view>
      <button wx:if="{{canSkip}}" class="route-pill" size="mini" style="width:auto;min-width:0;margin:0;padding:14rpx 24rpx;font-size:25rpx;font-weight:400;line-height:1.4;" disabled="{{operating}}" bindtap="skipCurrent">跳过此项</button>
    </view>

    <view class="map-card" wx:if="{{hasMap}}">
      <view class="floor-selector" style="width:{{mapSegments.length === 1 ? '120rpx' : '100%'}};" catchtouchstart="startFloorDrag" catchtouchmove="moveFloorDrag" catchtouchend="endFloorDrag" catchtouchcancel="endFloorDrag">
        <view class="floor-slider" style="width:{{100 / mapSegments.length}}%;transform:translateX({{activeFloorIndex * 100}}%);"></view>
        <view wx:for="{{mapSegments}}" wx:key="id" class="floor-option {{activeFloorIndex === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectFloor" role="button" aria-label="切换到{{item.floorKey}}">{{item.floorKey}}</view>
      </view>
      <view wx:if="{{activeSegment.instruction}}" class="map-instruction">{{activeSegment.instruction}}</view>
      <canvas id="indoorMap" canvas-id="indoorMap" class="nav-map-canvas" bindtouchstart="startFloorSwipe" bindtouchend="endFloorSwipe" bindtouchcancel="cancelFloorSwipe"></canvas>
      <view wx:if="{{activeSegment.transition}}" class="map-transition">{{activeSegment.transition}}</view>
    </view>
    <view wx:else class="map-card">
      <view class="nav-map-placeholder">{{location || '暂未提供楼层简图，请以现场标识为准'}}</view>
    </view>

    <view class="direction-card">
      <image class="direction-icon" src="../../addpicture/icons/iconfont/direction.svg" mode="aspectFit"></image>
      <view class="direction-copy">
        <view class="direction-title">{{floorInstruction}}</view>
        <view class="direction-meta">{{duration || '时间不可用'}}<text wx:if="{{distance !== '暂无路线数据'}}">　|　{{distance}}</text></view>
      </view>
    </view>

    <button class="primary-btn main-btn" style="width:100%;margin-left:0;margin-right:0;" disabled="{{operating}}" bindtap="completeNavigation">完成导航</button>
    <view class="utility-actions">
      <view class="utility-action" bindtap="goOverview">查看体检总览</view>
      <view class="utility-divider"></view>
      <view class="utility-action" bindtap="pausePlan">中断体检</view>
      <view class="utility-divider"></view>
      <view class="utility-action" bindtap="finishPlan">结束体检</view>
    </view>
  </scroll-view>
</view>
<ai-agent />
