@import '../../app.wxss';

page { background: linear-gradient(180deg, #F7FAFF 0%, #FFFFFF 100%); }
.navigation-page { min-height: 100vh; }
.route-notice { margin-bottom: 20rpx; padding: 22rpx; color: #52617A; background: #EDF4FF; border-radius: 20rpx; font-size: 23rpx; line-height: 1.5; }
.flow-nav { height: var(--navigation-bar-height, 44px); padding: 0 28rpx; display: flex; align-items: center; justify-content: space-between; }
.nav-back { width: 64rpx; height: 64rpx; display: flex; align-items: center; color: #101827; font-size: 58rpx; }
.nav-title { color: #111827; font-size: 31rpx; font-weight: 650; }
.nav-space { width: 64rpx; }
.navigation-scroll { width: 100%; height: calc(100vh - var(--status-bar-height, 24px) - var(--navigation-bar-height, 44px)); padding: 12rpx 24rpx calc(env(safe-area-inset-bottom) + 150rpx); box-sizing: border-box; }
.destination-card, .map-card, .direction-card { background: rgba(255,255,255,0.94); border: 2rpx solid #DFE7F2; border-radius: 28rpx; box-shadow: 0 16rpx 42rpx rgba(50,75,118,0.07); }
.destination-card { min-height: 120rpx; padding: 20rpx 24rpx; display: flex; align-items: center; gap: 20rpx; }
.destination-pin { width: 56rpx; height: 56rpx; flex: none; display: block; }
.destination-copy { flex: 1; min-width: 0; color: #263248; font-size: 27rpx; font-weight: 600; line-height: 1.45; }
.destination-copy text { margin-left: 10rpx; color: #2F69EC; font-size: 29rpx; }
.destination-card .route-pill { width: auto; min-width: 0; height: 56rpx; min-height: 56rpx; margin: 0; padding: 0 24rpx; display: flex; align-items: center; justify-content: center; line-height: 1; box-sizing: border-box; }
.map-card { margin-top: 18rpx; padding: 14rpx; }
.floor-selector { position: relative; display: flex; height: 64rpx; margin: 6rpx auto 18rpx; border-radius: 999rpx; background: #EDF2FA; overflow: hidden; }
.floor-slider { position: absolute; left: 0; top: 0; height: 100%; border: 5rpx solid #EDF2FA; box-sizing: border-box; border-radius: 999rpx; background: #2F69EC; transition: transform .18s ease; }
.floor-option { position: relative; flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; color: #52617A; font-size: 25rpx; line-height: 1; font-weight: 600; }
.floor-option.selected { color: white; }
.map-heading { padding: 10rpx 12rpx; color: #172033; font-size: 28rpx; font-weight: 650; }
.map-instruction { padding: 0 12rpx 14rpx; color: #52617A; font-size: 23rpx; line-height: 1.5; }
.map-transition { margin-top: 12rpx; padding: 18rpx; border-radius: 14rpx; color: #1350BE; background: #EDF4FF; font-size: 24rpx; line-height: 1.5; }
.nav-map-canvas, .nav-map-placeholder { width: 100%; height: 490rpx; border-radius: 22rpx; background: #F8FAFC; }
.nav-map-placeholder { padding: 36rpx; display: flex; align-items: center; justify-content: center; color: #7B8798; text-align: center; font-size: 24rpx; }
.direction-card { min-height: 126rpx; margin-top: 18rpx; padding: 24rpx; display: flex; align-items: center; gap: 22rpx; }
.direction-icon { width: 70rpx; height: 70rpx; flex: none; display: block; }
.direction-copy { min-width: 0; }
.direction-title { color: #172033; font-size: 27rpx; font-weight: 650; line-height: 1.5; }
.direction-meta { margin-top: 10rpx; color: #718096; font-size: 22rpx; }
.main-btn { width: 100%; margin: 24rpx 0 0; }
.utility-actions { min-height: 78rpx; margin: 8rpx 0 0; display: flex; align-items: center; justify-content: center; }
.utility-action { padding: 14rpx 20rpx; color: #737F91; font-size: 24rpx; font-weight: 500; line-height: 1; }
.utility-divider { width: 2rpx; height: 24rpx; flex: none; background: #C7CED8; }
