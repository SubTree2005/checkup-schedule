<view class="flow-page safe-top">
  <view class="flow-nav">
    <view class="nav-back" bindtap="goBack" aria-label="返回">‹</view>
    <view class="nav-title">确认已选项目</view>
    <view class="nav-space"></view>
  </view>

  <view class="flow-content" wx:if="{{!loading}}">
    <view class="summary-card">
      <view class="summary-head">
        <view>
          <view class="summary-title">{{selectionName}}</view>
          <view class="summary-count">已选项目（共 {{totalItems}} 项）</view>
        </view>
        <view class="detail-link" bindtap="toggleDetails">{{detailOpen ? '收起详情' : '查看详情'}}</view>
      </view>

      <view class="summary-row" wx:for="{{summaryGroups}}" wx:key="key">
        <view>{{item.label}}</view><view class="summary-number">{{item.count}} 项</view>
      </view>

      <view wx:if="{{detailOpen}}" class="selected-detail">
        <view class="selected-line" wx:for="{{selectedItems}}" wx:key="id">
          <view>{{item.name}}</view><view>{{item.department}}</view>
        </view>
      </view>
    </view>

    <view class="duration-card">
      <view>
        <view class="card-label">预计总时长</view>
        <view class="duration-value">{{durationLabel}}</view>
        <view class="duration-note">实际时间以现场安排为准</view>
      </view>
      <image class="clock-graphic" src="../../addpicture/icons/icon-clock-art.png" mode="aspectFit"></image>
    </view>

    <view class="preparation-card">
      <view class="card-label">检前准备要求</view>
      <view class="preparation-row" wx:for="{{preparationItems}}" wx:key="key">
        <view class="prep-dot"></view>
        <view><text class="prep-label">{{item.label}}：</text>{{item.text}}</view>
      </view>
    </view>
  </view>

  <view class="flow-bottom-bar">
    <button class="primary-btn continue-btn" bindtap="goNext">继续</button>
  </view>
</view>
<ai-agent />
