@import '../../app.wxss';

page { background: linear-gradient(180deg, #F6F9FE 0%, #FFFFFF 100%); }
.flow-page { min-height: 100vh; }
.flow-nav { height: 128rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: space-between; }
.nav-back { width: 64rpx; height: 64rpx; display: flex; align-items: center; color: #101827; font-size: 58rpx; font-weight: 300; }
.nav-title { color: #111827; font-size: 31rpx; font-weight: 650; }
.nav-space { width: 64rpx; }
.flow-content { padding: 10rpx 28rpx 190rpx; }

.selected-hospital { min-height: 94rpx; padding: 20rpx 24rpx; display: flex; align-items: center; justify-content: space-between; background: rgba(232, 241, 255, 0.78); border-radius: 22rpx; }
.selected-label { color: #78869B; font-size: 21rpx; }
.selected-name { max-width: 510rpx; margin-top: 6rpx; overflow: hidden; color: #263246; font-size: 24rpx; font-weight: 600; line-height: 1.4; white-space: normal; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.change-link { color: #2F69EC; font-size: 24rpx; }

.mode-tabs { margin: 24rpx 0 18rpx; display: flex; border-bottom: 2rpx solid #E5EBF4; }
.mode-tab { width: 50%; height: 76rpx; position: relative; display: flex; align-items: center; justify-content: center; color: #68758B; font-size: 27rpx; }
.mode-tab-active { color: #2F69EC; font-weight: 600; }
.mode-tab-active::after { content: ''; position: absolute; left: 24%; right: 24%; bottom: -2rpx; height: 5rpx; background: #2F69EC; border-radius: 999rpx; }
.page-note { padding: 30rpx 6rpx; color: #7A879B; font-size: 25rpx; }

.package-card,
.department-card { margin-top: 20rpx; background: rgba(255, 255, 255, 0.92); border: 2rpx solid rgba(218, 226, 239, 0.82); border-radius: 28rpx; box-shadow: 0 14rpx 36rpx rgba(52, 76, 118, 0.07); }
.package-card { padding: 26rpx; }
.package-selected { border-color: #4E82F2; box-shadow: 0 15rpx 38rpx rgba(47, 105, 236, 0.12); }
.package-head { display: flex; align-items: flex-start; gap: 22rpx; }
.package-copy { flex: 1; min-width: 0; }
.package-name { color: #172033; font-size: 29rpx; font-weight: 600; }
.package-desc { margin-top: 10rpx; color: #6A778C; font-size: 23rpx; line-height: 1.55; }
.radio-circle { width: 38rpx; height: 38rpx; flex: none; display: flex; align-items: center; justify-content: center; color: #FFFFFF; background: #FFFFFF; border: 3rpx solid #BBC6D8; border-radius: 50%; font-size: 23rpx; }
.package-selected .radio-circle { background: #2F69EC; border-color: #2F69EC; }

.preview-list { margin-top: 22rpx; display: flex; gap: 14rpx; overflow: hidden; }
.preview-item { width: 104rpx; flex: none; text-align: center; }
.preview-icon { width: 62rpx; height: 62rpx; margin: 0 auto; display: block; }
.preview-name { min-height: 76rpx; margin-top: 8rpx; overflow: hidden; color: #58657A; font-size: 19rpx; line-height: 1.3; white-space: normal; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
.package-foot { margin-top: 22rpx; padding-top: 18rpx; display: flex; align-items: center; justify-content: space-between; border-top: 2rpx solid #EFF2F7; }
.package-meta { color: #66748A; font-size: 22rpx; }
.package-price { color: #E56B2F; font-size: 27rpx; font-weight: 600; }

.department-card { padding: 0 24rpx; }
.department-name { padding: 24rpx 0 18rpx; color: #172033; font-size: 28rpx; font-weight: 600; }
.project-row { min-height: 94rpx; display: flex; align-items: center; justify-content: space-between; border-top: 2rpx solid #EEF2F7; }
.project-copy { flex: 1; min-width: 0; }
.project-name { color: #2C374A; font-size: 25rpx; }
.project-duration { margin-top: 6rpx; color: #8A96A8; font-size: 21rpx; }

.flow-bottom-bar { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; padding: 18rpx 28rpx calc(env(safe-area-inset-bottom) + 18rpx); background: #FAFCFF; border-top: 2rpx solid rgba(222, 229, 239, 0.72); }
.continue-btn { width: 100%; margin: 0; }
