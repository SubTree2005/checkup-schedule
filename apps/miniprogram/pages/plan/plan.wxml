<view class="operation-page safe-top" wx:if="{{plan && currentStep}}">
  <view class="flow-nav">
    <view class="nav-back" bindtap="goBack" aria-label="返回">‹</view>
    <view class="nav-title">排队与体检</view>
    <view class="nav-space"></view>
  </view>

  <scroll-view class="operation-scroll" scroll-y="true">
    <view class="current-card">
      <view class="item-head">
        <image class="item-icon" src="{{currentStep.iconPath}}" mode="aspectFit"></image>
        <view class="item-head-copy">
          <view class="item-title">{{currentStep.title}}</view>
          <view class="item-badges"><view class="current-badge">当前项目</view><view class="step-count">第 {{currentStepNumber}} 项 / 共 {{totalSteps}} 项</view></view>
        </view>
      </view>

      <view class="location-row">
        <image class="row-icon" src="../../addpicture/icons/iconfont/location.svg" mode="aspectFit"></image>
        <view class="location-copy">
          <view class="location-text">{{currentStep.department}}</view>
          <view wx:if="{{currentStep.locationHint}}" class="location-hint">{{currentStep.locationHint}}</view>
        </view>
        <button class="replan-btn" loading="{{operating}}" bindtap="onReplan"><image class="replan-icon" src="../../addpicture/icons/iconfont/reroute.svg" mode="aspectFit"></image><text>重排路线</text></button>
      </view>

      <view class="metric-row">
        <view class="metric-label"><image class="row-icon" src="../../addpicture/icons/iconfont/clock.svg" mode="aspectFit"></image>预计排队</view>
        <view><text class="metric-number">{{currentStep.queueWait || 0}}</text><text class="metric-unit"> 分钟</text></view>
      </view>
      <view class="metric-row queue-row">
        <view class="metric-label"><image class="row-icon" src="../../addpicture/icons/iconfont/queue-people.svg" mode="aspectFit"></image>排队状态</view>
        <view class="queue-copy">当前叫号：<text class="unavailable">不可用</text><text wx:if="{{queueAhead > 0}}">，您前方 {{queueAhead}} 人</text></view>
      </view>
    </view>

    <view class="reminder-card" wx:if="{{reminder}}">
      <view class="reminder-heading">当前提醒</view>
      <view class="reminder-body">
        <image class="reminder-icon" src="{{reminder.iconPath}}" mode="aspectFit"></image>
        <view class="reminder-copy">
          <view class="reminder-title">{{reminder.title}}</view>
          <view class="reminder-detail">{{reminder.detail}}</view>
        </view>
      </view>
    </view>

    <button class="primary-btn main-btn" style="width:100%;margin-left:0;margin-right:0;" loading="{{operating}}" disabled="{{operating}}" bindtap="handleMainAction">{{mainActionText}}</button>
    <view class="utility-actions">
      <view class="utility-action" bindtap="goOverview">查看体检总览</view>
      <view class="utility-divider"></view>
      <view class="utility-action" bindtap="pausePlan">中断体检</view>
      <view class="utility-divider"></view>
      <view class="utility-action" bindtap="finishPlan">结束体检</view>
    </view>
  </scroll-view>
</view>

<view class="operation-page safe-top" wx:else>
  <view class="flow-nav"><view class="nav-space"></view><view class="nav-title">排队与体检</view><view class="nav-space"></view></view>
  <view class="empty-state">当前暂无进行中的体检<button class="primary-btn empty-btn" bindtap="backHome">返回首页</button></view>
</view>
<ai-agent />
