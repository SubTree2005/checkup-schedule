@import '../../app.wxss';

page { background: linear-gradient(180deg, #F7FAFF 0%, #FFFFFF 100%); }
.flow-page { min-height: 100vh; }
.flow-nav { height: 128rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: space-between; }
.nav-back { width: 64rpx; height: 64rpx; display: flex; align-items: center; color: #101827; font-size: 58rpx; }
.nav-title { color: #111827; font-size: 31rpx; font-weight: 650; }
.nav-space { width: 64rpx; }
.flow-content { padding: 48rpx 28rpx 260rpx; }
.question-title { color: #172033; font-size: 35rpx; font-weight: 650; line-height: 1.45; }
.question-desc { margin-top: 18rpx; color: #66748A; font-size: 25rpx; line-height: 1.65; }
.requirement-card { margin-top: 38rpx; padding: 8rpx 28rpx; background: rgba(255,255,255,0.94); border: 2rpx solid #E0E7F1; border-radius: 30rpx; box-shadow: 0 16rpx 42rpx rgba(50,75,118,0.07); }
.requirement-row { min-height: 168rpx; display: flex; align-items: center; gap: 28rpx; border-bottom: 2rpx solid #EDF1F6; }
.requirement-row:last-child { border-bottom: none; }
.requirement-icon { width: 104rpx; height: 104rpx; flex: none; display: block; filter: drop-shadow(0 8rpx 16rpx rgba(70, 95, 140, .09)); }
.requirement-copy { flex: 1; min-width: 0; }
.requirement-title { color: #172033; font-size: 29rpx; font-weight: 600; }
.requirement-detail { margin-top: 12rpx; color: #64728A; font-size: 23rpx; line-height: 1.55; }
.action-area { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; padding: 18rpx 28rpx calc(env(safe-area-inset-bottom) + 28rpx); background: rgba(251,253,255,0.9); }
.action-primary { width: 100%; margin: 0; }
.text-action { height: 82rpx; display: flex; align-items: center; justify-content: center; color: #2F69EC; font-size: 28rpx; }
