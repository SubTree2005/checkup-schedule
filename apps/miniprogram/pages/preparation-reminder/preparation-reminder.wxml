<view class="flow-page safe-top">
  <view class="flow-nav">
    <view class="nav-back" bindtap="goBack" aria-label="返回">‹</view>
    <view class="nav-title">准备与提醒</view>
    <view class="nav-space"></view>
  </view>

  <view class="flow-content">
    <view class="section-heading"><image class="heading-icon" src="../../addpicture/icons/iconfont/id-card.svg" mode="aspectFit"></image><view>检查前准备要求</view></view>
    <view class="requirement-card">
      <view class="requirement-row" wx:for="{{requirements}}" wx:key="key">
        <image class="requirement-icon" src="{{item.iconPath}}" mode="aspectFit"></image>
        <view class="requirement-copy"><text class="requirement-title">{{item.title}}：</text>{{item.detail}}</view>
      </view>
    </view>

    <view class="section-heading reminder-heading"><image class="heading-icon" src="../../addpicture/icons/iconfont/bell.svg" mode="aspectFit"></image><view>提醒设置</view></view>
    <view class="reminder-card">
      <view class="reminder-row">
        <image class="reminder-icon" src="../../addpicture/icons/iconfont/wechat.svg" mode="aspectFit"></image>
        <view class="reminder-copy">
          <view class="reminder-title">微信消息推送</view>
          <view class="reminder-desc">{{reminderStatusText}}</view>
        </view>
        <switch checked="{{wechatPush}}" disabled="{{!wechatPushAvailable}}" color="#2F69EC" data-key="wechatPush" bindchange="setReminder" />
      </view>
      <view class="reminder-row">
        <image class="reminder-icon" src="../../addpicture/icons/iconfont/calendar-plus.svg" mode="aspectFit"></image>
        <view class="reminder-copy">
          <view class="reminder-title">导入系统日历</view>
          <view class="reminder-desc">将预约时间添加到手机系统日历</view>
        </view>
        <switch checked="{{systemCalendar}}" color="#2F69EC" data-key="systemCalendar" bindchange="setReminder" />
      </view>
    </view>

    <view class="change-hint">如需修改预约日期或时间，请返回上一步操作</view>
  </view>

  <view class="flow-bottom-bar"><button class="primary-btn continue-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="confirmAppointment">确认预约</button></view>
</view>
<ai-agent />
