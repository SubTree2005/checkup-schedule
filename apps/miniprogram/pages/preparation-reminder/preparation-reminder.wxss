@import '../../app.wxss';

page { background: linear-gradient(180deg, #F7FAFF 0%, #FFFFFF 100%); }
.flow-page { min-height: 100vh; }
.flow-nav { height: 128rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: space-between; }
.nav-back { width: 64rpx; height: 64rpx; display: flex; align-items: center; color: #101827; font-size: 58rpx; }
.nav-title { color: #111827; font-size: 31rpx; font-weight: 650; }
.nav-space { width: 64rpx; }
.flow-content { padding: 8rpx 28rpx 190rpx; }
.section-heading { margin: 16rpx 0 22rpx; display: flex; align-items: center; gap: 14rpx; color: #172033; font-size: 30rpx; font-weight: 600; }
.heading-icon { width: 46rpx; height: 46rpx; display: block; }
.requirement-card, .reminder-card { padding: 0 26rpx; background: rgba(255,255,255,0.94); border: 2rpx solid #E0E7F1; border-radius: 28rpx; box-shadow: 0 14rpx 38rpx rgba(50,75,118,0.06); }
.requirement-row { min-height: 104rpx; display: flex; align-items: center; gap: 22rpx; color: #4D5B70; font-size: 23rpx; line-height: 1.5; border-bottom: 2rpx solid #EDF1F6; }
.requirement-row:last-child { border-bottom: none; }
.requirement-icon { width: 68rpx; height: 68rpx; flex: none; display: block; }
.requirement-copy { flex: 1; min-width: 0; }
.requirement-title { color: #172033; font-weight: 600; }
.reminder-heading { margin-top: 34rpx; }
.reminder-row { min-height: 128rpx; display: flex; align-items: center; gap: 20rpx; border-bottom: 2rpx solid #EDF1F6; }
.reminder-row:last-child { border-bottom: none; }
.reminder-icon { width: 68rpx; height: 68rpx; flex: none; display: block; }
.reminder-copy { flex: 1; min-width: 0; }
.reminder-title { color: #172033; font-size: 26rpx; font-weight: 600; }
.reminder-desc { margin-top: 8rpx; color: #718096; font-size: 21rpx; line-height: 1.45; }
.change-hint { margin: 28rpx 10rpx 0; color: #7A879A; font-size: 21rpx; line-height: 1.5; }
.flow-bottom-bar { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; padding: 18rpx 28rpx calc(env(safe-area-inset-bottom) + 18rpx); background: rgba(250,252,255,0.92); }
.continue-btn { width: 100%; margin: 0; }
