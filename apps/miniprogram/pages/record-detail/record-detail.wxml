<view class="detail-page safe-top" wx:if="{{record}}">
  <view class="flow-nav"><view class="nav-back" bindtap="goBack" aria-label="返回">‹</view><view class="nav-title">体检详情</view><view class="nav-space"></view></view>

  <scroll-view class="detail-scroll" scroll-y="true">
    <view class="summary-card">
      <image class="hospital-photo" src="{{record.hospitalImage}}" mode="aspectFill"></image>
      <view class="summary-copy">
        <view class="hospital-name">{{record.hospitalName}}</view>
        <view class="package-name">{{record.packageName}}</view>
        <view class="completion-date">{{record.completionDate}}</view>
      </view>
      <view class="status-badge status-{{record.statusTone}}">{{record.displayStatus}}</view>
    </view>

    <view class="detail-tabs">
      <view class="detail-tab {{activeTab === 'items' ? 'detail-tab-active' : ''}}" data-tab="items" bindtap="setTab">项目情况</view>
      <view class="detail-tab {{activeTab === 'reports' ? 'detail-tab-active' : ''}}" data-tab="reports" bindtap="setTab">体检报告</view>
    </view>

    <view class="items-card">
      <view class="item-row" wx:for="{{steps}}" wx:key="detailID" data-id="{{item.detailID}}" bindtap="openStep">
        <view class="item-title">{{item.title}}</view>
        <view class="item-status item-{{item.statusTone}}">{{item.statusText}}</view>
        <view class="item-arrow">›</view>
      </view>
    </view>
  </scroll-view>
</view>

<view class="detail-page safe-top" wx:else>
  <view class="flow-nav"><view class="nav-space"></view><view class="nav-title">体检详情</view><view class="nav-space"></view></view>
  <view class="empty-state">正在加载体检记录</view>
</view>
<ai-agent />
