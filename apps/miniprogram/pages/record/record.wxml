<view class="record-page tab-page safe-top" style="padding-top: {{statusBarHeight}}px;">
  <view class="record-nav" style="height: {{navigationBarHeight}}px;"><view class="record-title">体检</view></view>

  <view class="record-tabs">
    <view class="record-tab-indicator {{activeTab === 'history' ? 'is-history' : ''}}"></view>
    <view class="record-tab {{activeTab === 'appointments' ? 'record-tab-active' : ''}}" data-tab="appointments" bindtap="setTab">预约体检</view>
    <view class="record-tab {{activeTab === 'history' ? 'record-tab-active' : ''}}" data-tab="history" bindtap="setTab">历史体检</view>
  </view>

  <view class="record-content {{!loading && contentEmpty ? 'record-content-empty' : ''}}">
    <view wx:if="{{loading}}" class="record-note">正在读取体检安排</view>
    <block wx:elif="{{activeTab === 'appointments'}}">
      <view wx:if="{{!hasPlans}}" class="record-note">当前暂无体检</view>
      <block wx:else>
        <view wx:if="{{highlightPlan}}" class="focus-plan focus-{{highlightPlan.state}}">
          <view class="focus-state"><image class="state-symbol" src="{{highlightPlan.stateIconPath}}" mode="aspectFit"></image><view>{{highlightPlan.stateLabel}}</view></view>
          <view class="focus-hospital">{{highlightPlan.hospitalName}}</view>
          <view class="focus-type">{{highlightPlan.examType}}</view>
          <view class="plan-time"><image class="clock-icon" src="../../addpicture/icons/iconfont/clock.svg" mode="aspectFit"></image>{{highlightPlan.appointmentLabel}}</view>
          <view class="focus-divider"></view>
          <view class="focus-bottom">
            <view class="focus-progress">{{highlightPlan.progressText}}</view>
            <view class="focus-actions">
              <view class="detail-pill" data-id="{{highlightPlan.id}}" bindtap="viewDetail" role="button">查看详情</view>
              <view wx:if="{{highlightPlan.showPrimaryAction}}" class="primary-btn action-pill" data-id="{{highlightPlan.id}}" bindtap="openPlan" role="button">{{highlightPlan.actionText}}</view>
            </view>
          </view>
        </view>
        <view wx:if="{{showOtherHeading}}" class="other-heading">其他预约</view>
        <view class="appointment-card" wx:for="{{otherPlans}}" wx:key="id">
          <view class="appointment-hospital">{{item.hospitalName}}</view>
          <view class="appointment-type">{{item.examType}}</view>
          <view class="appointment-bottom">
            <view class="plan-time appointment-time"><image class="clock-icon" src="../../addpicture/icons/iconfont/clock.svg" mode="aspectFit"></image>{{item.appointmentLabel}}</view>
            <view class="detail-pill" data-id="{{item.id}}" bindtap="viewDetail" role="button">查看详情</view>
          </view>
        </view>
      </block>
    </block>
    <block wx:else>
      <view wx:if="{{!hasHistory}}" class="record-note">暂无历史体检</view>
      <view class="year-group" wx:for="{{historyGroups}}" wx:key="year">
        <view class="year-title">{{item.year}}</view>
        <view class="history-record-card" wx:for="{{item.items}}" wx:for-item="record" wx:key="id" data-id="{{record.id}}" bindtap="viewHistoryDetail">
          <image class="hospital-photo" src="{{record.hospitalImage}}" mode="aspectFill"></image>
          <view class="record-copy">
            <view class="history-hospital-name">{{record.hospitalName}}</view>
            <view class="history-package-name">{{record.packageName}}</view>
            <view class="record-date">{{record.dateLabel}}</view>
          </view>
          <view class="status-badge status-{{record.statusTone}}">{{record.status}}</view>
          <view class="record-arrow">›</view>
        </view>
      </view>
    </block>
  </view>

</view>
<ai-agent with-tab-bar show-add bind:add="createPlan" />
