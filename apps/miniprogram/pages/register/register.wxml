<view class="container">
  <view class="page-head">
    <view class="page-title">注册账号</view>
  </view>

  <view class="card register-card">
    <view class="section-title">基础资料</view>

    <view class="compact-form">
      <view class="compact-row">
        <view class="row-label">姓名</view>
        <input class="row-input" placeholder="请输入姓名" placeholder-class="input-placeholder" data-key="name" bindinput="onInput" value="{{form.name}}" />
      </view>
      <view class="compact-row">
        <view class="row-label">性别</view>
        <view class="segmented-control">
          <view class="segment {{form.gender==='女' ? 'segment-active' : ''}}" data-value="女" bindtap="setGender">女</view>
          <view class="segment {{form.gender==='男' ? 'segment-active' : ''}}" data-value="男" bindtap="setGender">男</view>
        </view>
      </view>
      <view class="compact-row">
        <view class="row-label">年龄</view>
        <input class="row-input" type="number" placeholder="请输入年龄" placeholder-class="input-placeholder" data-key="age" bindinput="onInput" value="{{form.age}}" />
      </view>
      <view class="compact-row">
        <view class="row-label">手机号</view>
        <input class="row-input" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="input-placeholder" data-key="phone" bindinput="onInput" value="{{form.phone}}" />
      </view>
      <view class="compact-row">
        <view class="row-label">设置密码</view>
        <input class="row-input" password="true" placeholder="请设置登录密码" placeholder-class="input-placeholder" data-key="password" bindinput="onInput" value="{{form.password}}" />
      </view>
      <view class="compact-row">
        <view class="row-label">确认密码</view>
        <input class="row-input" password="true" placeholder="请再次输入密码" placeholder-class="input-placeholder" data-key="confirmPassword" bindinput="onInput" value="{{form.confirmPassword}}" />
      </view>
    </view>
  </view>

  <view class="card register-card health-card">
    <view class="section-title">健康信息</view>

    <view class="compact-form">
      <view class="compact-row">
        <view class="row-label">既往病史</view>
        <input class="row-input" placeholder="无则填写无" placeholder-class="input-placeholder" data-key="medicalHistory" bindinput="onInput" value="{{form.medicalHistory}}" />
      </view>
      <view class="compact-row last-row">
        <view class="row-label">过敏原</view>
        <input class="row-input" placeholder="无则填写无" placeholder-class="input-placeholder" data-key="allergens" bindinput="onInput" value="{{form.allergens}}" />
      </view>
    </view>
  </view>

  <view class="register-actions">
    <view class="policy-row mt-24" bindtap="togglePolicies">
      <view class="policy-check {{acceptedPolicies ? 'policy-check-active' : ''}}">{{acceptedPolicies ? '✓' : ''}}</view>
      <view class="policy-copy">
        我已阅读并同意
        <text class="policy-link" catchtap="openTerms">《用户协议》</text>
        和
        <text class="policy-link" catchtap="openPrivacy">《隐私政策》</text>
        ，并同意按所选体检服务处理必要的健康信息。
      </view>
    </view>

    <button class="primary-btn mt-32" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitRegister">完成注册</button>
  </view>
</view>
