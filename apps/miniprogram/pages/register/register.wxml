<view class="container">
  <view class="page-head">
    <view class="page-title">注册账号</view>
    <view class="page-desc">请完善基础信息，注册成功后会自动同步到个人信息页面。</view>
  </view>

  <view class="card">
    <view class="section-title">基础资料</view>

    <view class="field-card mt-24">
      <view class="label">姓名</view>
      <input class="input" placeholder="请输入姓名" data-key="name" bindinput="onInput" value="{{form.name}}" />
    </view>

    <view class="field-card mt-24">
      <view class="label">性别</view>
      <view class="option-row">
        <view class="option {{form.gender==='女' ? 'option-active' : ''}}" data-value="女" bindtap="setGender">女</view>
        <view class="option {{form.gender==='男' ? 'option-active' : ''}}" data-value="男" bindtap="setGender">男</view>
      </view>
    </view>

    <view class="field-card mt-24">
      <view class="label">年龄</view>
      <input class="input" type="number" placeholder="请输入年龄" data-key="age" bindinput="onInput" value="{{form.age}}" />
    </view>

    <view class="field-card mt-24">
      <view class="label">手机号</view>
      <input class="input" type="number" placeholder="请输入手机号" data-key="phone" bindinput="onInput" value="{{form.phone}}" />
    </view>

    <view class="field-card mt-24">
      <view class="label">设置密码</view>
      <input class="input" password="true" placeholder="请设置登录密码" data-key="password" bindinput="onInput" value="{{form.password}}" />
    </view>

    <view class="policy-row mt-24" bindtap="togglePolicies">
      <view class="policy-check {{acceptedPolicies ? 'policy-check-active' : ''}}">{{acceptedPolicies ? '✓' : ''}}</view>
      <view class="policy-copy">
        我已阅读并同意
        <text class="policy-link" catchtap="openTerms">《用户协议》</text>
        和
        <text class="policy-link" catchtap="openPrivacy">《隐私政策》</text>
        ，并同意按所选体检服务处理必要的健康信息。
      </view>
    </view>

    <button class="primary-btn mt-32" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitRegister">完成注册</button>
  </view>
</view>
