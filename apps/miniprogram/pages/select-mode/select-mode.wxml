<view class="flow-page safe-top">
  <view class="flow-nav">
    <view class="nav-back" bindtap="goBack" aria-label="返回">‹</view>
    <view class="nav-title">选择体检方式</view>
    <view class="nav-space"></view>
  </view>

  <view class="flow-content">
    <view class="page-hint"><view class="hint-dot"></view>请选择一种体检方式</view>

    <view class="mode-card" data-mode="appointment" bindtap="chooseMode">
      <image class="mode-icon" src="../../addpicture/icons/iconfont/calendar.svg" mode="aspectFit"></image>
      <view class="mode-copy">
        <view class="mode-title">预约体检</view>
        <view class="mode-desc">提前预约日期和时间，按时到院体检</view>
      </view>
      <view class="mode-arrow">›</view>
    </view>

    <view class="mode-card" data-mode="realtime" bindtap="chooseMode">
      <image class="mode-icon" src="../../addpicture/icons/iconfont/clock.svg" mode="aspectFit"></image>
      <view class="mode-copy">
        <view class="mode-title">实时体检</view>
        <view class="mode-desc">到院后根据现场情况，实时安排体检</view>
      </view>
      <view class="mode-arrow">›</view>
    </view>
  </view>
</view>
<ai-agent />
