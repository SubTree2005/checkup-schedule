<view class="container">
  <view class="card choice-card" bindtap="goPackage">
    <view class="choice-mark blue-mark"></view>
    <view class="choice-main">
      <view class="choice-title">按体检套餐选择</view>
      <view class="choice-desc">适合快速选择已有套餐内容，系统将继续为你规划最优路线。</view>
    </view>
  </view>

  <view class="card choice-card mt-24" bindtap="goDepartmentProjects">
    <view class="choice-mark green-mark"></view>
    <view class="choice-main">
      <view class="choice-title">按科室选择检查项目</view>
      <view class="choice-desc">先按科室勾选检查项目，后续将逐步完善定制化组合与规划能力。</view>
    </view>
  </view>
</view>
