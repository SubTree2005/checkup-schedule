@import '../../app.wxss';
.choice-card { display:flex; align-items:flex-start; gap: 20rpx; }
.choice-mark { width: 22rpx; height: 22rpx; border-radius: 50%; margin-top: 10rpx; flex-shrink:0; }
.blue-mark { background:#4F83F1; }
.green-mark { background:#27AE60; }
.choice-main { flex:1; }
.choice-title { font-size: 32rpx; font-weight: 700; color:#1F2A44; }
.choice-desc { margin-top: 12rpx; font-size: 25rpx; color:#6B7280; line-height: 1.7; }
